# Copy to .env.local and fill in. Never commit real values.
# Only NEXT_PUBLIC_* values reach the browser; everything else stays on the server.

# --- Firebase web app (public; from `firebase apps:sdkconfig web`) ---
NEXT_PUBLIC_FIREBASE_API_KEY=          # web API key (identifies the project; not a secret)
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=      # e.g. your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=       # Firebase project id
NEXT_PUBLIC_FIREBASE_APP_ID=           # web app id, e.g. 1:123:web:abc
NEXT_PUBLIC_USE_EMULATOR=false         # true = use local Auth/Firestore emulators (ignored in production builds)

# --- Firebase Admin SDK (SECRET; from the service-account JSON) ---
FIREBASE_ADMIN_PROJECT_ID=             # "project_id" in the JSON
FIREBASE_ADMIN_CLIENT_EMAIL=           # "client_email" in the JSON
FIREBASE_ADMIN_PRIVATE_KEY=            # "private_key" in the JSON, in double quotes, keep the \n sequences

# --- Access control ---
ALLOWED_EMAIL_DOMAIN=                  # e.g. yourcollege.ac.in (only this domain may sign in)
MENTOR_EMAILS=                         # comma-separated emails that get the mentor role
VIEWER_EMAILS=                         # comma-separated emails that get the read-only viewer role

# --- AI feedback (SECRET keys) ---
AI_PROVIDER=anthropic                  # anthropic | gemini
AI_MODEL=                              # model id for the chosen provider
ANTHROPIC_API_KEY=                     # needed when AI_PROVIDER=anthropic
GEMINI_API_KEY=                        # needed when AI_PROVIDER=gemini

# --- Code judge (SECRET) ---
GITHUB_JUDGE_REPO=                     # org/repo of the private judge repository
GITHUB_JUDGE_TOKEN=                    # fine-grained token scoped to the judge repo only
JUDGE_WEBHOOK_SECRET=                  # shared HMAC secret for judge callbacks (long random string)

# --- Misc ---
CRON_SECRET=                           # protects /api/cron/recompute (long random string)
APP_BASE_URL=                          # public URL of the app, e.g. https://your-app.vercel.app
